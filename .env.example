# Identidad de la app. Ver docs/BRANDING.md
NEXT_PUBLIC_APP_NAME=CASA
NEXT_PUBLIC_APP_FULL_NAME=Círculo de Apoyo y Servicios para Afiliados
NEXT_PUBLIC_APP_TAGLINE=Gestión de afiliados, pagos y beneficios
NEXT_PUBLIC_APP_DESCRIPTION=Beneficios y servicios para afiliados en Medellín.

# Logos (rutas dentro de /public, p. ej. /brand/logo.svg, o URL absoluta).
# Vacíos: se genera un monograma con las iniciales de NEXT_PUBLIC_APP_NAME en el color primario.
NEXT_PUBLIC_LOGO_FULL=
NEXT_PUBLIC_LOGO_MARK=
NEXT_PUBLIC_LOGO_LOGIN=
NEXT_PUBLIC_FAVICON=
# Iniciales del monograma (opcional, máx. 2). Por defecto salen del nombre.
NEXT_PUBLIC_APP_MONOGRAM=

# Color primario (hex de 6 dígitos). Press, fondo suave y acentos se derivan de este valor.
# Va entre comillas: sin ellas, el # se interpreta como comentario.
# Si se omite, se usa el verde bosque de CASA (#1E5631).
NEXT_PUBLIC_BRAND_COLOR="#1E5631"

# API propio (Route Handlers en src/app/api). Por defecto, /api del mismo dominio.
NEXT_PUBLIC_BACKEND_URL_BASE=/api

# URL pública del sitio (SEO / canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:4200

# Session timeout (minutos)
NEXT_PUBLIC_SESSION_TIMEOUT_MODAL_COUNTDOWN_MINUTES=3
NEXT_PUBLIC_SESSION_TIMEOUT_INACTIVITY_TIMEOUT_MINUTES=30

# --- Solo servidor (nunca con prefijo NEXT_PUBLIC_) ---

# Neon: conexión con pooler (la usa la app) y directa (la usa Prisma para migrar).
DATABASE_URL=
DIRECT_URL=

# Firma de la cookie de sesión. Genera uno con: openssl rand -base64 32
AUTH_SECRET=

# Protege /api/cron/fees. Vercel lo envía como "Authorization: Bearer <valor>".
CRON_SECRET=

# Primer administrador (lo crea la semilla si no existe; cambia la clave al entrar).
ADMIN_EMAIL=
ADMIN_PASSWORD=
